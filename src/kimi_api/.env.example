# Copy to .env at the workspace root (or next to wherever you launch
# `ros2 run kimi_api ...`) and fill in the key. python-dotenv will pick it up
# automatically when each kimi_api node starts.

# Required: OpenRouter API key
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Optional: override if pointing at a self-hosted gateway or different provider
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: override the default vision-capable model
LLM_MODEL=google/gemini-2.5-pro
