# uses orbbec camera to track person
string target_frame # set to none to use camera frame
string target_point_topic # empty → use server param default (/target_points)
bool return_rgb_img
bool return_depth_img
bool return_segment
bool debug  # When true, draws all detected person bounding boxes on the RGB image
---
int32 status
string message
---
bool target_lost
int32 target_track_id
bool is_transformation_successful
geometry_msgs/PointStamped target_position
sensor_msgs/Image rgb_img
sensor_msgs/Image depth_img
sensor_msgs/Image segment_img
