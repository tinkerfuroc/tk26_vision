# Analyze the latest fresh RGB frame. No depth or TF required.
---
# Capture stamp/frame copied from the input image (not inference completion).
std_msgs/Header header
uint8 STATUS_OK=0
uint8 STATUS_NO_IMAGE=1
uint8 STATUS_VLM_ERROR=2
uint8 STATUS_LOG_ERROR=3
uint8 status
string error_msg
# True iff at least one requested behaviour / litter candidate was found.
# Only interpret a negative result when status == STATUS_OK.
bool detected
SceneObservation[] observations
sensor_msgs/Image rgb_image
sensor_msgs/Image annotated_image
# Absolute path to the corresponding vision_log JSON, including timestamps.
string log_json
