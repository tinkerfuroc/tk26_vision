# Generalist object-detection request.
#
# A clean redesign of the legacy string-flag ObjectDetection.srv:
#   - string 'flags'    -> typed boolean sort + payload toggles
#   - string 'category' -> dropped (was unused)
#   - adds VLM+SAM-fallback knobs and a 'detection_source' output tag

# camera in ['realsense', 'orbbec']
string camera

# Natural-language or class name. If it matches a YOLO class name, YOLO runs.
# Otherwise the VLM+SAM fallback may run (see flags below).
string prompt

# TF frame to express centroids in. Empty string = raw camera frame.
string target_frame

# --- sorting (replaces the 'sort_closest'/'sort_highest' substrings in the old string 'flags') ---
bool sort_closest
bool sort_highest

# --- payload toggles (replaces 'request_image'/'request_segments' substrings) ---
bool return_rgb_image
bool return_depth_image
bool return_segments

# --- generalist-specific ---
# Operator override: skip YOLO entirely and run VLM + FastSAM only,
# regardless of the node-level `enable_vlm` parameter. Field name is
# historical (kept for ABI compatibility).
bool force_vlm_sam
# Per-request opt-in for the open-vocab fallback when `prompt` is not in
# the YOLO class list, or when YOLO returns zero matches. When set, the
# server runs YOLO-World and Gemini VLM concurrently; if YOLO-World
# returns objects first, the VLM result is abandoned (the network call
# continues in the background but is discarded). Otherwise the server
# waits for the VLM and returns its result. When false, the auto-fallback
# path is governed by the node-level `enable_vlm` / `allow_auto_fallback`
# parameters.
bool use_vlm_sam_fallback

---

std_msgs/Header header
# 0 = ok; 1 = empty / failure (see error_msg)
int32 status
string error_msg
# Kept for ABI parity with the legacy srv; generalist does not register people, so 0.
int32 person_id
Object[] objects
# 'yolo' | 'yolo_world' | 'vlm_sam' | 'none' — which branch produced results.
string detection_source

sensor_msgs/Image rgb_image
sensor_msgs/Image depth_image
sensor_msgs/Image[] segments
